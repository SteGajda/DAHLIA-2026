# ---------------------------------------------------------------------------
# DAHLIA Backend — Environment Variables Template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
# NEVER commit the `.env` file to the repository.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Default dev-loop (SQLite — no server installation required):
DATABASE_URL=sqlite+pysqlite:///./dahlia_dev.db

# MS SQL Server (local Docker / Azure SQL):
# DATABASE_URL=mssql+pyodbc://user:password@localhost:1433/dahlia_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- Security / JWT --------------------------------------------------------
# Generate a cryptographically secure key, e.g.: openssl rand -hex 32
# Each environment (dev / staging / prod) must have a DIFFERENT key.
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Access Token lifetime (in minutes). Default: 30.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token lifetime (in days). Default: 30.
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Environment -----------------------------------------------------------
# Values: development | production
APP_ENV=development
